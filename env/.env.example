# Copy to env/.env.<NODE_ENV> and adjust. Values below are the defaults.

# development | test | production
NODE_ENV=development
APP_NAME=telemetry-tracing
PORT=3000

# Index of this process when running clustered; shown in the log prefix.
# Falls back to NODE_APP_INSTANCE (pm2), then 0.
INSTANCE_ID=0

# error | warn | info | http | verbose | debug | silly
# Defaults to debug outside production, info in production.
LOG_LEVEL=debug

# json | pretty
# Defaults to pretty outside production, json in production.
LOG_FORMAT=pretty

# Solana JSON-RPC endpoint. Defaults to the public mainnet endpoint, which is
# rate limited — use a dedicated provider for anything beyond local testing.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- OpenTelemetry ---------------------------------------------------------
# Only the routes listed in TRACED_ROUTES (src/core/telemetry/telemetry.ts) are
# traced. Metrics are served for Prometheus to scrape on OTEL_PROMETHEUS_PORT.

OTEL_ENABLED=true
# otlp | console | both. Defaults to console outside production.
OTEL_TRACES_EXPORTER=console
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# 0 disables the metrics endpoint.
OTEL_PROMETHEUS_PORT=9464
# Trace every route instead of just TRACED_ROUTES.
OTEL_TRACE_ALL=false
