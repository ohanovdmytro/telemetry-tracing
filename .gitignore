# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Tests
coverage/
.nyc_output/

# Secrets — every env file except the committed template.
# The negation must come after the pattern, or it has no effect.
env/.env
env/.env.*
!env/.env.example
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime / process managers
pids/
*.pid
*.seed

# Caches
.npm/
.eslintcache
.cache/
*.tgz

# Editors
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local Solana keypairs — never commit a signing key
*.keypair.json
id.json
